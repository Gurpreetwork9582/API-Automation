{
  "$schema": "http://json-schema.org/draft-07/schema#",

  "type": "object",

  "required": [
    "postId",
    "id",
    "name",
    "email",
    "body"
  ],

  "properties": {

    "postId": {
      "type": "integer"
    },

    "id": {
      "type": "integer"
    },

    "name": {
      "type": "string",
      "minLength": 1
    },

    "email": {
      "type": "string",
      "minLength": 1
    },

    "body": {
      "type": "string",
      "minLength": 1
    }
  },

  "additionalProperties": false
}